# Copy to .env and fill in for production. In development the defaults are fine.

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://brandonherford.com

TIME_ZONE=America/New_York

# Development uses SQLite automatically (no value needed).
# For production, point at PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/brandon
